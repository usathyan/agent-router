{
  "description": "agent-router checkpoints (advisory, fail open) and a record-only trace of the first-principles agent's decisions. See integrations/first-principles/README.md.",
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "Agent|Bash", "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook", "timeout": 15}]},
      {"matcher": "Agent", "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/trace", "timeout": 10}]}
    ],
    "SubagentStart": [
      {"matcher": "first-principles:first-principles", "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/trace", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"matcher": "first-principles:first-principles", "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/trace", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|Read|ToolSearch|WebFetch|WebSearch|mcp__plugin_agent-router-fp_agent_router__calc", "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/trace", "timeout": 10}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Bash|Read|WebFetch|WebSearch|mcp__plugin_agent-router-fp_agent_router__calc", "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/trace", "timeout": 10}]}
    ]
  }
}
